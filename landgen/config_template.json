{
  "start_year": 2015,
  "end_year": 2015,
  "source_data_path": "/global/cfs/cdirs/e3sm/landgen/rawdata",
  "landgen_grid_path": "healpix/10km/land_domain_file_healpix_10km.nc",
  "ocean_shapefile_path": "ne_10m_ocean/ne_10m_ocean.shp",
  "out_path": "/global/cfs/cdirs/e3sm/landgen/output_test",
  "modules": [
    {
      "name": "topography",
      "params": {
        "active": true,
        "out_fname": "landgen_topography.nc",
        "decomp_box_size_degrees": 10
      }
    },
    {
      "name": "land_type",
      "params": {
        "active": true,
        "out_fname": "landgen_land_type.nc",
        "submod_run": {
          "landcover": true,
          "crop": false,
          "urban": false,
          "lake": false,
          "ice": false,
          "wetland": false,
          "management": true,
          "veg_char": false
        },
        "submod_dyn": {
          "landcover": true,
          "crop": true,
          "urban": false,
          "lake": false,
          "ice": false,
          "wetland": false,
          "management": true,
          "veg_char": false
        },
        "submod_sources": {
          "landcover": {
            "rs_data": {"path": "modis", "name": "modis"}
          },
          "crop":    {},
          "urban":   {},
          "lake":    {},
          "ice":     {},
          "wetland": {},
          "management": {
            "harvest": {"path": "LUH2/LUH2_v2h", "name": "transitions.nc"},
            "grazing": {
              "path": "HYDE3.5/original/gbc2025_7apr_base/NetCDF",
              "names": {"pasture": "pasture.nc", "rangeland": "rangeland.nc"}
            }
          },
          "veg_char": {
            "lai":{"path": "global_1k_surface_parameter/VEGE", "name": "LAI_{year}_1k_c230606.nc", "variable": "LAI"},
            "sai":{"path": "global_1k_surface_parameter/VEGE", "name": "SAI_{year}_1k_c230606.nc", "variable": "SAI"},
            "canopy_height_top":{"path": "global_1k_surface_parameter/VEGE", "name":"CANOPY_HEIGHT_TOP_1k_c230606.nc", "variable": "CANOPY_HEIGHT_TOP"},
            "canopy_height_bot":{"path": "global_1k_surface_parameter/VEGE", "name":"CANOPY_HEIGHT_BOT_1k_c230606.nc", "variable": "CANOPY_HEIGHT_BOT"},
            "voc": {
              "path": "fvoc",
              "names": {
                "crop": "EFMAP.2019b.GLOBE.0.5deg.2020.crop.nc",
                "grass": "EFMAP.2019b.GLOBE.0.5deg.2020.grass.nc",
                "shrub": "EFMAP.2019b.GLOBE.0.5deg.2020.shrub.nc",
                "tree": "EFMAP.2019b.GLOBE.0.5deg.2020.tree.nc"
              },
              "variable": "EF_ISOP"
            }
          }
        },
        "submod_decomp_box_size_degrees": {
          "landcover": 10,
          "crop": 10,
          "urban": 10,
          "lake": 10,
          "ice": 10,
          "wetland": 10,
          "management": 5,
          "veg_char": 10
        }
      }
    },
    {
      "name": "soil",
      "params": {
        "active": true,
        "out_fname": "landgen_soil.nc",
        "decomp_box_size_degrees": 10
      }
    },
    {
      "name": "human",
      "params": {
        "active": true,
        "out_fname": "landgen_human.nc",
        "decomp_box_size_degrees": 10
      }
    },
    {
      "name": "atmosphere",
      "params": {
        "active": true,
        "out_fname": "landgen_atmosphere.nc",
        "decomp_box_size_degrees": 10
      }
    }
